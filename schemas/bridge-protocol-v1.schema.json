{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cubase-mcp:bridge-protocol:v1",
  "title": "Cubase Bridge Protocol v1 Message",
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/response"
    },
    {
      "$ref": "#/$defs/errorResponse"
    },
    {
      "$ref": "#/$defs/event"
    }
  ],
  "$defs": {
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "id",
        "type",
        "method",
        "params"
      ],
      "properties": {
        "version": {
          "$ref": "#/$defs/version"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "const": "request"
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "params": {
          "type": "object"
        }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "id",
        "type",
        "result"
      ],
      "properties": {
        "version": {
          "$ref": "#/$defs/version"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "const": "response"
        },
        "result": {
          "type": "object"
        }
      }
    },
    "errorResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "id",
        "type",
        "error"
      ],
      "properties": {
        "version": {
          "$ref": "#/$defs/version"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "const": "error"
        },
        "error": {
          "$ref": "#/$defs/error"
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "type",
        "event",
        "data"
      ],
      "properties": {
        "version": {
          "$ref": "#/$defs/version"
        },
        "type": {
          "const": "event"
        },
        "event": {
          "type": "string",
          "minLength": 1
        },
        "data": {
          "type": "object"
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "enum": [
            "NOT_CONNECTED",
            "PROJECT_NOT_OPEN",
            "NOT_SUPPORTED",
            "INVALID_ARGUMENT",
            "TRACK_NOT_FOUND",
            "MARKER_NOT_FOUND",
            "COMMAND_NOT_FOUND",
            "COMMAND_NOT_ALLOWED",
            "TIMEOUT",
            "BUSY",
            "PROTOCOL_ERROR",
            "INTERNAL_ERROR"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
